local dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        updateMiniPosition()
    end
end)

--==================================================
--=== STAGE 5 ===
--==================================================

local eggState, assetsDir, assetEarnings
local recordsByUid = {}
local moduleCache, infoCache, partCache = {}, {}, {}
local worldObjects, espLabels, carriedLabels = {}, {}, {}
local listEntries, eggInfoCache = {}, {}
local enabled, destroyed, scanBusy, refreshRequested = true, false, false, false
local forceWorldScan, lastDataRead, lastWorldScan = true, 0, 0
local connections = {}

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

local function findModule(names)
    local key = table.concat(names, "|")
    local cached = moduleCache[key]
    if cached and cached.Parent then return cached end
    moduleCache[key] = nil
    local roots = {
        ReplicatedStorage:FindFirstChild("Data"), ReplicatedStorage:FindFirstChild("Client"),
        ReplicatedStorage:FindFirstChild("Shared"), ReplicatedStorage, ReplicatedFirst,
        player:FindFirstChild("PlayerScripts")
    }
    local visited, checked = {}, 0
    for _, root in ipairs(roots) do
        if root and not visited[root] then
            visited[root] = true
            local ok, descendants = pcall(function() return root:GetDescendants() end)
            if ok then
                for _, object in ipairs(descendants) do
                    checked += 1
                    if checked > 15000 then return nil end
                    if object:IsA("ModuleScript") then
                        for _, name in ipairs(names) do
                            if object.Name:lower() == name:lower() then
                                moduleCache[key] = object
                                return object
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function safeRequire(names)
    local moduleScript = findModule(names)
    if not moduleScript then return nil end
    local ok, result = pcall(require, moduleScript)
    if ok and type(result) == "table" then return result end
    return nil
end

local function loadGameData(force)
    if not force and os.clock() - lastDataRead < DATA_CACHE_INTERVAL then return next(recordsByUid) ~= nil end
    lastDataRead = os.clock()
    eggState = eggState or safeRequire({"EggState", "EggStateClient"})
    assetsDir = assetsDir or safeRequire({"Assets", "AssetsDir", "AssetDirectory", "AssetsDirectory"})
    assetEarnings = assetEarnings or safeRequire({"AssetEarnings", "AssetEarning"})
    if assetsDir and type(assetsDir.Directory) == "table" then assetsDir = assetsDir.Directory end
    if not eggState or type(eggState.ReadFieldEggs) ~= "function" then return false end
    local ok, result = pcall(eggState.ReadFieldEggs)
    if not ok or type(result) ~= "table" or type(result.Records) ~= "table" then return false end
    local updated = {}
    for _, record in pairs(result.Records) do
        if type(record) == "table" and record.Uid ~= nil then updated[tostring(record.Uid)] = record end
    end
    recordsByUid = updated
    table.clear(infoCache)
    return true
end

local function getRecord(object)
    local current = object
    for _ = 1, 12 do
        if not current then break end
        for _, attribute in ipairs({"Uid", "UID", "EggUid", "AssetUid"}) do
            local ok, value = pcall(function() return current:GetAttribute(attribute) end)
            if ok and value ~= nil then
                local record = recordsByUid[tostring(value)]
                if record then return record end
            end
        end
        local record = recordsByUid[tostring(current.Name)]
        if record then return record end
        current = current.Parent
    end
    return nil
end

--==================================================
--=== STAGE 6 ===
--==================================================

local function findPart(object)
    if not object then return nil end
    local cached = partCache[object]
    if cached and cached.Parent and cached:IsA("BasePart") then return cached end
    if object:IsA("BasePart") then partCache[object] = object; return object end
    if not object:IsA("Model") then return nil end
    local hitbox = object:FindFirstChild("Hitbox", true)
    if hitbox and hitbox:IsA("BasePart") then partCache[object] = hitbox; return hitbox end
    local part = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    if part then partCache[object] = part end
    return part
end

local function getInfo(record)
    if type(record) ~= "table" then return nil, "Tidak tersedia", "Tidak tersedia", -1 end
    local uid = tostring(record.Uid or "")
    local cached = infoCache[uid]
    if uid ~= "" and cached and cached.record == record then return cached.name, cached.rate, cached.rarity, cached.numericRate end
    local asset
    if assetsDir and record.AssetCategory ~= nil then asset = assetsDir[record.AssetCategory] end
    local name = (asset and (asset.DisplayName or asset.Name)) or record.DisplayName or record.Name
    local rarity = (asset and asset.Rarity) or record.Rarity
    if type(rarity) == "table" then rarity = rarity.DisplayName or rarity._id or rarity.Id or rarity.Name end
    rarity = (type(rarity) == "string" and rarity ~= "") and rarity or "Tidak tersedia"
    local rate, numericRate = "Tidak tersedia", -1
    if type(assetEarnings) == "table" then
        local item = {Category = record.AssetCategory, Scale = tonumber(record.AssetScale) or 1, Mutations = record.Mutations or {}}
        local fn = assetEarnings.LiveRatePerSecond
        if type(fn) == "function" then
            local ok, value = pcall(fn, item, nil, nil, player)
            if ok and type(value) == "number" and value == value and value >= 0 and value < math.huge then numericRate = value end
        end
        if numericRate < 0 then
            fn = assetEarnings.MutationOnlyRatePerSecond
            if type(fn) == "function" then
                local ok, value = pcall(fn, item)
                if ok and type(value) == "number" and value == value and value >= 0 and value < math.huge then numericRate = value end
            end
        end
    end
    if numericRate >= 0 then
        rate = string.format("%.2f/s", numericRate)
    else
        local raw = record.Value or record.value or record.Income or record.IncomePerSecond
            or (asset and (asset.Value or asset.Income or asset.IncomePerSecond))
        if type(raw) == "number" and raw >= 0 and raw < math.huge then numericRate = raw; rate = tostring(raw) end
    end
    name = name and tostring(name) or nil
    if uid ~= "" then infoCache[uid] = {record = record, name = name, rate = rate, rarity = rarity, numericRate = numericRate} end
    return name, rate, rarity, numericRate
end

local function isUnknown(value)
    if value == nil then return true end
    local s = tostring(value):lower():match("^%s*(.-)%s*$")
    return s == "" or s == "unknown" or s == "undefined" or s == "nil" or s == "none" or s == "n/a" or s == "tidak tersedia" or s == "tidak diketahui"
end
local function hasValidInfo(name, rate, rarity)
    return not isUnknown(name) and not isUnknown(rate) and not isUnknown(rarity)
end

