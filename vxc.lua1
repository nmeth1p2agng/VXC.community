local espFolder = Instance.new("Folder")
espFolder.Name = "VXC_EggESP_Objects"
espFolder.Parent = gui

local function removeLabel(object)
    local billboard = espLabels[object]
    if billboard then billboard:Destroy() end
    espLabels[object] = nil
end
local function removeCarriedLabel(uid)
    local billboard = carriedLabels[uid]
    if billboard then billboard:Destroy() end
    carriedLabels[uid] = nil
end
local function clearESP()
    for object in pairs(espLabels) do removeLabel(object) end
    for uid in pairs(carriedLabels) do removeCarriedLabel(uid) end
end

local selectedEgg, selectedPart
local function selectEgg(object)
    if not object or not object.Parent then status.Text = "Target egg tidak tersedia"; return end
    selectedEgg, selectedPart = object, findPart(object)
    local info = eggInfoCache[object]
    selectedLabel.Text = "Target: " .. (info and info.name or object.Name)
    for eggObject, entry in pairs(listEntries) do
        local stroke = entry and entry:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = eggObject == selectedEgg and YELLOW or YELLOW_STROKE; stroke.Thickness = eggObject == selectedEgg and 2 or 1 end
    end
    status.Text = selectedPart and "Target dipilih: " .. object.Name or "Bagian fisik egg tidak ditemukan"
end

local function updateListEntry(object, name, rarity, rate, numericRate)
    local entry = listEntries[object]
    if not entry or not entry.Parent then
        entry = Instance.new("TextButton")
        entry.Name = "EggEntry"
        entry.Size = UDim2.new(1, -2, 0, 55)
        entry.BackgroundColor3 = Color3.fromRGB(25, 31, 44)
        entry.Text = ""
        entry.BorderSizePixel = 0
        entry.Parent = list
        Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 5)
        local stroke = Instance.new("UIStroke")
        stroke.Color = YELLOW_STROKE
        stroke.Thickness = 1
        stroke.Parent = entry
        for _, spec in ipairs({
            {"EggName", 3, 18, Color3.new(1,1,1), Enum.Font.GothamBold, 10},
            {"EggValue", 21, 15, GREEN, Enum.Font.Gotham, 9},
            {"EggRarity", 37, 14, PURPLE, Enum.Font.Gotham, 9}
        }) do
            local label = Instance.new("TextLabel")
            label.Name = spec[1]
            label.Size = UDim2.new(1, -10, 0, spec[3])
            label.Position = UDim2.fromOffset(5, spec[2])
            label.BackgroundTransparency = 1
            label.TextColor3 = spec[4]
            label.Font = spec[5]
            label.TextSize = spec[6]
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.TextTruncate = Enum.TextTruncate.AtEnd
            label.Parent = entry
        end
        entry.Activated:Connect(function() selectEgg(object) end)
        listEntries[object] = entry
    end
    entry.EggName.Text = "EGG: " .. name
    entry.EggValue.Text = "Value/Rate: " .. rate
    entry.EggRarity.Text = "Rarity: " .. rarity
    eggInfoCache[object] = {name = name, rarity = rarity, rate = rate, value = numericRate}
    if selectedEgg == object then selectedLabel.Text = "Target: " .. name end
end

local function sortEggList()
    local entries = {}
    for object, entry in pairs(listEntries) do
        if entry and entry.Parent and object.Parent then
            local info = eggInfoCache[object]
            table.insert(entries, {object = object, entry = entry, value = info and info.value or -1, name = info and info.name or object.Name})
        end
    end
    table.sort(entries, function(a, b)
        if a.value ~= b.value then return a.value > b.value end
        return a.name:lower() < b.name:lower()
    end)
    for index, item in ipairs(entries) do item.entry.LayoutOrder = index end
end

local function createESP(object, record)
    local part = findPart(object)
    if not part then return false end
    local name, rate, rarity, numericRate = getInfo(record)
    if not hasValidInfo(name, rate, rarity) then removeLabel(object); return false end
    updateListEntry(object, name, rarity, rate, numericRate)
    if not enabled then removeLabel(object); return true end
    local billboard = espLabels[object]
    if not billboard or not billboard.Parent then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "VXC_EggStatus"
        billboard.Size = UDim2.fromOffset(190, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = MAX_DISTANCE
        billboard.Parent = espFolder
        local label = Instance.new("TextLabel")
        label.Name = "Info"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
        label.BackgroundTransparency = 0.15
        label.TextColor3 = GREEN
        label.TextStrokeTransparency = 0.35
        label.Font = Enum.Font.GothamBold
        label.TextSize = 10
        label.TextWrapped = true
        label.Parent = billboard
        Instance.new("UICorner", label).CornerRadius = UDim.new(0, 5)
        local stroke = Instance.new("UIStroke")
        stroke.Color = YELLOW
        stroke.Thickness = 1.5
        stroke.Parent = label
        espLabels[object] = billboard
    end
    billboard.Adornee = part
    local label = billboard:FindFirstChild("Info")
    local text = name .. "\nRate: " .. rate .. " | Rarity: " .. rarity
    if label and label.Text ~= text then label.Text = text end
    return true
end

--==================================================
--=== STAGE 8 ===
--==================================================

local function isEggCandidate(object)
    if not object or not object.Parent or (not object:IsA("Model") and not object:IsA("BasePart")) then return false end
    local okPart, part = pcall(function() return findPart(object) end)
    if not okPart or not part then return false end
    local name = object.Name:lower()
    if name:find("egg", 1, true) or name:find("eggslot", 1, true) then return true end
    local okRecord, record = pcall(function() return getRecord(object) end)
    if okRecord and record ~= nil then return true end
    local current = object.Parent
    for _ = 1, 12 do
        if not current then break end
        local ancestorName = current.Name:lower()
        if ancestorName:find("egg", 1, true) or ancestorName == "placedeggrenders" or ancestorName == "areaeggslotsclient" then return true end
        current = current.Parent
    end
    return false
end

--==================================================
--=== STAGE 9 ===
--==================================================

local function addCandidate(object)
    if destroyed or not object or not object.Parent then return end
    if isEggCandidate(object) then worldObjects[object] = true end
end
local function removeCandidate(object)
    worldObjects[object] = nil
    partCache[object] = nil
    removeLabel(object)
end
connect(Workspace.DescendantAdded, function(object)
    task.defer(function() if not destroyed and object.Parent then addCandidate(object) end end)
end)
connect(Workspace.DescendantRemoving, function(object) removeCandidate(object) end)

local function rebuildWorldCache()
    local ok, descendants = pcall(function() return Workspace:GetDescendants() end)
    if not ok then return end
    local rebuilt = {}
    for i, object in ipairs(descendants) do
        if isEggCandidate(object) then rebuilt[object] = true end
        if i % 500 == 0 then task.wait(); if destroyed then return end end
    end
    for object in pairs(worldObjects) do if object and object.Parent then rebuilt[object] = true end end
    worldObjects = rebuilt
    lastWorldScan = os.clock()
    forceWorldScan = false
end

--==================================================
--=== STAGE 10 ===
--==================================================

local function updateCarriedEggs()
    local seen, count = {}, 0
    for uid, record in pairs(recordsByUid) do
        if type(record) == "table" and tostring(record.State):lower() == "carried" then
            uid = tostring(uid)
            local carrierId = tonumber(record.CarrierUserId)
            local carrier = carrierId and Players:GetPlayerByUserId(carrierId)
            local character = carrier and carrier.Character
            local anchor = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
            local name, rate, rarity = getInfo(record)
            if enabled and anchor and hasValidInfo(name, rate, rarity) then
                seen[uid] = true
                count += 1
                local billboard = carriedLabels[uid]
                if not billboard or not billboard.Parent then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "VXC_CarriedEgg_" .. uid
                    billboard.Size = UDim2.fromOffset(190, 45)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.MaxDistance = MAX_DISTANCE
                    billboard.Parent = espFolder
                    local label = Instance.new("TextLabel")
                    label.Name = "Info"
                    label.Size = UDim2.fromScale(1, 1)
                    label.BackgroundColor3 = DARK_BACKGROUND
                    label.BackgroundTransparency = 0.12
                    label.TextColor3 = GREEN
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 10
                    label.TextWrapped = true
                    label.Parent = billboard
                    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 5)
                    local stroke = Instance.new("UIStroke")
                    stroke.Color = YELLOW
                    stroke.Thickness = 1.5
                    stroke.Parent = label
                    carriedLabels[uid] = billboard
                end
                billboard.Adornee = anchor
                local label = billboard:FindFirstChild("Info")
                local text = "CARRIED: " .. name .. "\nRate: " .. rate .. " | Rarity: " .. rarity
                if label and label.Text ~= text then label.Text = text end
            end
        end
    end
    for uid in pairs(carriedLabels) do if not seen[uid] then removeCarriedLabel(uid) end end
    return count
end

--==================================================
-- STAGE 11: FLIGHT CONTROLLER
--==================================================

local humanoid, rootPart
local function getCharacter()
    local character = player.Character
    if not character then return nil end
    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return nil end
    return character, hum, root
end
local function refreshCharacter()
    local _, hum, root = getCharacter()
    humanoid, rootPart = hum, root
end
local function getHoverDestination(egg)
    if not egg or not egg.Parent then return nil end
    local part = findPart(egg)
    if not part or not getCharacter() then return nil end
    return Vector3.new(part.Position.X, FLY_HEIGHT_Y, part.Position.Z)
end

local flyEnabled, flyToken = false, 0
local flyAttachment, flyVelocity, flyOrientation, flyConnection
local savedHumanoid, savedAutoRotate, savedPlatformStand
local returningToSpawn, returnToken = false, 0

local function destroyFlyObjects()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyOrientation then flyOrientation:Destroy(); flyOrientation = nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
end
local function stopFlying(message)
    flyEnabled = false
    flyToken += 1
    destroyFlyObjects()
    if savedHumanoid and savedHumanoid.Parent then
        savedHumanoid.AutoRotate = savedAutoRotate
        savedHumanoid.PlatformStand = savedPlatformStand
        pcall(function() savedHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    savedHumanoid = nil
    refreshCharacter()
    flyButton.Text = "AUTO FLY: OFF"
    flyButton.BackgroundColor3 = Color3.fromRGB(25, 115, 70)
    if message then status.Text = message end
end
local function createFlyController(root)
    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "VXC_FlyAttachment"
    flyAttachment.Parent = root
    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "VXC_FlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVelocity.ForceLimitsEnabled = false
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = root
    flyOrientation = Instance.new("AlignOrientation")
    flyOrientation.Name = "VXC_FlyOrientation"
    flyOrientation.Attachment0 = flyAttachment
    flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyOrientation.Responsiveness = 20
    flyOrientation.Parent = root
end
local function setFacingDirection()
    local camera = Workspace.CurrentCamera
    if not camera or not flyOrientation then return end
    local look = camera.CFrame.LookVector
    local horizontal = Vector3.new(look.X, 0, look.Z)
    if horizontal.Magnitude > 0.001 then flyOrientation.CFrame = CFrame.lookAt(Vector3.zero, horizontal.Unit) end
end

--==================================================
-- STAGE 12: RETURN TO SPAWN (FIXED)
--==================================================

local function findReturnTargetPart()
    local named = Workspace:FindFirstChild("SpawnLocation", true)
    if named and named:IsA("BasePart") then return named end
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("SpawnLocation") then return object end
    end
    return nil
end

local function returnToTargetPart()
    if not RETURN_TO_SPAWN_ENABLED or returningToSpawn then return end
    local character, hum, root = getCharacter()
    local targetPart = findReturnTargetPart()
    if not character or not targetPart then
        status.Text = not character and "Return gagal: karakter tidak tersedia" or "Return gagal: SpawnLocation tidak ditemukan"
        return
    end

    returningToSpawn = true
    returnToken += 1
    local myToken = returnToken
    stopFlying()
    character, hum, root = getCharacter()
    if not character then returningToSpawn = false; status.Text = "Return gagal: karakter tidak tersedia"; return end
    targetPart = findReturnTargetPart()
    if not targetPart then returningToSpawn = false; status.Text = "Return gagal: SpawnLocation tidak ditemukan"; return end

    local attachment = Instance.new("Attachment")
    attachment.Name = "VXC_ReturnAttachment"
    attachment.Parent = root
    local velocity = Instance.new("LinearVelocity")
    velocity.Name = "VXC_ReturnVelocity"
    velocity.Attachment0 = attachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    velocity.ForceLimitsEnabled = false
    velocity.VectorVelocity = Vector3.zero
    velocity.Parent = root

    local oldAutoRotate = hum.AutoRotate
    hum.AutoRotate = false

    -- Actual WalkSpeed, no forced minimum and no percentage multiplier.
    local speed = math.max(0, hum.WalkSpeed)
    local startedAt = os.clock()
    local reached, cancelled = false, false

    while gui.Parent and myToken == returnToken and os.clock() - startedAt < RETURN_TIMEOUT do
        local currentCharacter, currentHum, currentRoot = getCharacter()
        if not currentCharacter or currentCharacter ~= character or currentRoot ~= root then
            cancelled = true
            break
        end
        targetPart = findReturnTargetPart()
        if not targetPart then status.Text = "Return gagal: SpawnLocation hilang"; break end

        local targetPosition = Vector3.new(targetPart.Position.X, FLY_HEIGHT_Y, targetPart.Position.Z)
        local offset = targetPosition - root.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        local horizontalDistance = horizontal.Magnitude
        local verticalDifference = offset.Y

        -- If WalkSpeed is zero, do not silently substitute a faster speed.
        local horizontalSpeed = speed
        if horizontalDistance < RETURN_SLOW_DISTANCE then
            horizontalSpeed = speed * math.clamp(horizontalDistance / RETURN_SLOW_DISTANCE, 0.15, 1)
        end
        local horizontalVelocity = Vector3.zero
        if horizontalDistance > 0.15 and speed > 0 then
            horizontalVelocity = horizontal.Unit * horizontalSpeed
        end
        local verticalVelocity = math.clamp(verticalDifference * 8, -100, 100)
        velocity.VectorVelocity = Vector3.new(horizontalVelocity.X, verticalVelocity, horizontalVelocity.Z)

        if horizontalDistance <= RETURN_ARRIVAL_DISTANCE and math.abs(verticalDifference) <= HEIGHT_TOLERANCE then
            reached = true
            break
        end
        status.Text = string.format("RETURN | Jarak %.1f | WalkSpeed %.1f", horizontalDistance, speed)
        RunService.Heartbeat:Wait()
    end

    if velocity.Parent then velocity:Destroy() end
    if attachment.Parent then attachment:Destroy() end
    if hum.Parent then hum.AutoRotate = oldAutoRotate end
    if myToken ~= returnToken then return end
    if root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    returningToSpawn = false
    refreshCharacter()

    if reached then
        if AUTO_FLY_OFF_AFTER_RETURN then stopFlying("Return selesai | AUTO FLY OFF") end
        status.Text = "Tiba di atas SpawnLocation | AUTO FLY OFF"
    elseif cancelled then
        status.Text = "Return dibatalkan"
    else
        status.Text = "Return gagal: target tidak tercapai"
    end
end

--==================================================
--=== STAGE 13 ===
--==================================================

local pickupConfirmed, pickupTargetUid, pickupTargetState, pickupLastCheck = false, nil, nil, 0
local function getEggRecordState(targetEgg)
    if not targetEgg then return nil, nil end
    local record = getRecord(targetEgg)
    if not record then return nil, nil end
    local uid = tostring(record.Uid or "")
    return tostring(record.State or ""):lower(), uid ~= "" and uid or nil
end
local function checkPickupStatus(targetUid)
    if not targetUid then return "unknown" end
    loadGameData(true)
    local record = recordsByUid[tostring(targetUid)]
    if not record then return "unknown" end
    local state = tostring(record.State or ""):lower()
    if state == "carried" then
        pickupConfirmed = true
        pickupTargetState = "carried"
        return "carried"
    end
    pickupTargetState = state
    return state
end

local lastStealAttempt, stealBusy = 0, false
local function getCarryPromptNearTarget(targetEgg)
    local targetPart = findPart(targetEgg)
    if not targetPart then return nil end
    local bestPrompt, bestDistance = nil, math.huge
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "SmartPromptPart" then
            local prompt = object:FindFirstChild("CarryAreaEgg")
            if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                local promptPart = object:IsA("BasePart") and object or object:FindFirstChildWhichIsA("BasePart", true)
                if promptPart then
                    local distance = (promptPart.Position - targetPart.Position).Magnitude
                    if distance < bestDistance then bestDistance, bestPrompt = distance, prompt end
                end
            end
        end
    end
    if bestDistance <= STEAL_MAX_DISTANCE then return bestPrompt end
    return nil
end
local function tryAutoSteal(targetEgg, forceAttempt)
    if not AUTO_STEAL_ENABLED or stealBusy or not targetEgg or not targetEgg.Parent then return end
    if not forceAttempt and os.clock() - lastStealAttempt < STEAL_RETRY_DELAY then return end
    local _, _, root = getCharacter()
    if not root then return end
    local prompt = getCarryPromptNearTarget(targetEgg)
    if not prompt then return end
    local promptPart = prompt.Parent
    if not promptPart:IsA("BasePart") then promptPart = prompt:FindFirstAncestorWhichIsA("BasePart") end
    if not promptPart or (root.Position - promptPart.Position).Magnitude > STEAL_MAX_DISTANCE then return end
    lastStealAttempt = os.clock()
    stealBusy = true
    task.spawn(function()
        local ok, result = pcall(function()
            if typeof(fireproximityprompt) == "function" then fireproximityprompt(prompt); return true end
            return false
        end)
        if gui.Parent then
            status.Text = ok and result and "Interaksi dicoba; menunggu respons server..." or "Auto Steal tidak didukung oleh executor ini"
            task.wait(0.5)
            if gui.Parent and not targetEgg.Parent then
                status.Text = "Target menghilang; periksa hasil pickup"
            elseif gui.Parent and selectedEgg == targetEgg and ok and result then
                status.Text = "Pickup belum terkonfirmasi oleh data game"
            end
        end
        stealBusy = false
    end)
end

--==================================================
-- STAGE 14: AUTO FLY SYSTEM
-- MATCHED HORIZONTAL SPEED EDITION
--==================================================

local function startFlying()
    if flyEnabled or returningToSpawn then return end
    if not selectedEgg or not selectedEgg.Parent then
        status.Text = "Pilih egg dari daftar terlebih dahulu"
        return
    end

    local targetEgg = selectedEgg
    if not findPart(targetEgg) then
        status.Text = "Bagian fisik egg tidak ditemukan"
        return
    end

    local character, hum, root = getCharacter()
    if not character then
        status.Text = "Karakter belum siap"
        return
    end
    if root.Anchored then
        status.Text = "HumanoidRootPart terkunci"
        return
    end

    destroyFlyObjects()

    savedHumanoid = hum
    savedAutoRotate = hum.AutoRotate
    savedPlatformStand = hum.PlatformStand

    hum.AutoRotate = false
    hum.PlatformStand = false

    createFlyController(root)

    flyEnabled = true
    flyToken += 1

    local token = flyToken
    local startedAt = os.clock()
    local phase = "APPROACH"

    local pickupWaitStarted, targetLostStarted = nil, nil
    local lastPickupCheckLocal, lastStealRetry = 0, 0

    loadGameData(true)

    local initialState, targetUid = getEggRecordState(targetEgg)

    pickupConfirmed = initialState == "carried"
    pickupTargetUid = targetUid
    pickupTargetState = initialState
    pickupLastCheck = 0

    flyButton.Text = "AUTO FLY: ON"
    flyButton.BackgroundColor3 = Color3.fromRGB(20, 160, 90)
    status.Text = "Terbang menuju egg: " .. targetEgg.Name

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyEnabled or token ~= flyToken then
            return
        end

        local currentCharacter, currentHum, currentRoot = getCharacter()

        if not currentCharacter
            or currentCharacter ~= character
            or currentRoot ~= root then
            stopFlying("Karakter berubah atau tidak tersedia")
            return
        end

        local now = os.clock()

        if now - startedAt >= FLY_TIMEOUT then
            stopFlying("Batas waktu penerbangan tercapai")
            return
        end

        if pickupConfirmed then
            phase = "ASCEND"
        end

        -- Menunggu konfirmasi pickup jika egg menghilang.
        if phase ~= "ASCEND" and not targetEgg.Parent then
            if not targetLostStarted then
                targetLostStarted = now
            end

            if now - lastPickupCheckLocal >= PICKUP_POLL_INTERVAL then
                lastPickupCheckLocal = now

                local state = checkPickupStatus(targetUid)

                if state == "carried" then
                    pickupConfirmed = true
                    pickupTargetState = "carried"
                    phase = "ASCEND"

                    status.Text =
                        "Pickup terkonfirmasi | Naik ke Y 115.93"
                end
            end

            if phase ~= "ASCEND" then
                if now - targetLostStarted >= PICKUP_CONFIRM_TIMEOUT then
                    stopFlying(
                        "Egg hilang; status carried tidak terkonfirmasi"
                    )
                    return
                end

                flyVelocity.VectorVelocity = Vector3.zero
                status.Text = "Egg hilang | Menunggu konfirmasi carried"
                return
            end
        end

        local targetPart = targetEgg.Parent and findPart(targetEgg)

        if (phase == "APPROACH" or phase == "DESCEND")
            and not targetPart then
            stopFlying("Bagian fisik egg tidak ditemukan")
            return
        end

        if phase == "APPROACH" then
            local targetPosition = Vector3.new(
                targetPart.Position.X,
                FLY_HEIGHT_Y,
                targetPart.Position.Z
            )

            local offset = targetPosition - currentRoot.Position

            local horizontal = Vector3.new(
                offset.X,
                0,
                offset.Z
            )

            local distance = horizontal.Magnitude
            local verticalDifference = offset.Y

            -- KECEPATAN HORIZONTAL DISAMAKAN.
            local horizontalVelocity = Vector3.zero

            if distance > APPROACH_DISTANCE then
                horizontalVelocity =
                    horizontal.Unit * FLY_HORIZONTAL_SPEED
            end

            local verticalVelocity = math.clamp(
                verticalDifference * 5,
                -ASCEND_SPEED,
                ASCEND_SPEED
            )

            flyVelocity.VectorVelocity = Vector3.new(
                horizontalVelocity.X,
                verticalVelocity,
                horizontalVelocity.Z
            )

            if distance <= APPROACH_DISTANCE
                and math.abs(verticalDifference) <= HEIGHT_TOLERANCE then

                phase = "DESCEND"
                pickupWaitStarted = nil
                lastPickupCheckLocal = 0
                lastStealRetry = 0

                status.Text = "Mendekati egg | Turun ke Y 71.19"
            end

        elseif phase == "DESCEND" then
            local targetPosition = Vector3.new(
                targetPart.Position.X,
                EGG_PICKUP_HEIGHT_Y,
                targetPart.Position.Z
            )

            local offset = targetPosition - currentRoot.Position

            local horizontal = Vector3.new(
                offset.X,
                0,
                offset.Z
            )

            local distance = horizontal.Magnitude
            local verticalDifference = offset.Y

            -- KECEPATAN HORIZONTAL SAMA DENGAN APPROACH.
            local horizontalVelocity = Vector3.zero

            if distance > APPROACH_DISTANCE then
                horizontalVelocity =
                    horizontal.Unit * FLY_HORIZONTAL_SPEED
            end

            local verticalVelocity = math.clamp(
                verticalDifference * 10,
                -DESCEND_SPEED,
                DESCEND_SPEED
            )

            flyVelocity.VectorVelocity = Vector3.new(
                horizontalVelocity.X,
                verticalVelocity,
                horizontalVelocity.Z
            )

            if distance <= APPROACH_DISTANCE
                and math.abs(verticalDifference) <= HEIGHT_TOLERANCE then

                flyVelocity.VectorVelocity = Vector3.zero

                if not pickupWaitStarted then
                    pickupWaitStarted = now
                end

                if now - lastPickupCheckLocal >= PICKUP_POLL_INTERVAL then
                    lastPickupCheckLocal = now

                    local state = checkPickupStatus(targetUid)

                    if state == "carried" then
                        pickupConfirmed = true
                        pickupTargetState = "carried"
                        phase = "ASCEND"

                        status.Text =
                            "Egg carried terkonfirmasi | Naik kembali"
                    end
                end

                if phase == "DESCEND" then
                    if now - lastStealRetry >= STEAL_RETRY_DELAY then
                        lastStealRetry = now
                        tryAutoSteal(targetEgg, true)
                    end

                    if now - pickupWaitStarted >= PICKUP_CONFIRM_TIMEOUT then
                        stopFlying(
                            "Pickup tidak terkonfirmasi | Auto Fly dihentikan"
                        )
                        return
                    end

                    status.Text = string.format(
                        "Menunggu pickup | Y: %.2f",
                        currentRoot.Position.Y
                    )
                end
            end

        elseif phase == "ASCEND" then
            local verticalDifference =
                FLY_HEIGHT_Y - currentRoot.Position.Y

            flyVelocity.VectorVelocity = Vector3.new(
                0,
                math.clamp(
                    verticalDifference * 8,
                    -ASCEND_SPEED,
                    ASCEND_SPEED
                ),
                0
            )

            if math.abs(verticalDifference) <= HEIGHT_TOLERANCE then
                flyVelocity.VectorVelocity = Vector3.zero

                stopFlying(
                    "Pickup terkonfirmasi | Memulai perjalanan pulang"
                )

                if RETURN_TO_SPAWN_ENABLED then
                    task.spawn(returnToTargetPart)
                else
                    status.Text = "Ketinggian tercapai | AUTO FLY OFF"
                end

                return
            end
        end

        setFacingDirection()
    end)
end

--==================================================
--=== STAGE 15 ===
--==================================================

local function scan(force)
    if scanBusy or destroyed then if force then refreshRequested = true end; return end
    scanBusy = true
    local ok, err = pcall(function()
        loadGameData(force == true)
        if force or forceWorldScan or os.clock() - lastWorldScan >= WORLD_RESCAN_INTERVAL then rebuildWorldCache() end
        local live, seenUid = {}, {}
        local matched, labeled, filtered = 0, 0, 0

        for object in pairs(worldObjects) do
            if destroyed then break end
            if not object or not object.Parent then
                worldObjects[object] = nil
                removeLabel(object)
            else
                local record = getRecord(object)
                if record then
                    local uid = tostring(record.Uid or "")
                    if uid == "" or not seenUid[uid] then
                        if uid ~= "" then seenUid[uid] = true end
                        if tostring(record.State):lower() == "carried" then
                            removeLabel(object)
                            live[object] = true
                        else
                            local name, rate, rarity = getInfo(record)
                            if hasValidInfo(name, rate, rarity) then
                                matched += 1
                                live[object] = true
                                if createESP(object, record) then labeled += 1 end
                            else
                                filtered += 1
                                removeLabel(object)
                            end
                        end
                    else
                        live[object] = true
                    end
                else
                    removeLabel(object)
                end
            end
        end

        for object, billboard in pairs(espLabels) do
            if not enabled or not live[object] then
                if billboard then billboard:Destroy() end
                espLabels[object] = nil
            end
        end

        for object, entry in pairs(listEntries) do
            if not live[object] or not object.Parent then
                -- Do not cancel an active pickup/return sequence just because
                -- the target disappeared from the scanned world list.
                if entry then entry:Destroy() end
                listEntries[object] = nil
                eggInfoCache[object] = nil
                if selectedEgg == object then
                    selectedLabel.Text = "Target: menunggu konfirmasi pickup"
                    if not flyEnabled and not returningToSpawn then
                        selectedEgg, selectedPart = nil, nil
                    end
                end
            end
        end

        sortEggList()
        local carried = updateCarriedEggs()
        if not flyEnabled and not returningToSpawn then
            status.Text = string.format("%s | Egg: %d | Label: %d | Carried: %d | Unknown: %d", enabled and "ESP ON" or "ESP OFF", matched, labeled, carried, filtered)
        end
    end)
    scanBusy = false
    if not ok then
        warn("[VXC EGG ESP V3.4.9] Scan error:", err)
        status.Text = "Scan error - cek Output"
    end
    if refreshRequested and not destroyed then refreshRequested = false; forceWorldScan = true end
end

--==================================================
--=== STAGE 16 ===
--==================================================

toggleButton.Activated:Connect(function()
    enabled = not enabled
    toggleButton.Text = enabled and "ESP: ON" or "ESP: OFF"
    if not enabled then clearESP(); status.Text = "ESP OFF | Daftar tetap aktif" else status.Text = "ESP ON | Memperbarui..." end
    scan(false)
end)
scanButton.Activated:Connect(function() forceWorldScan = true; scan(true) end)
flyButton.Activated:Connect(function()
    if flyEnabled then
        stopFlying("Auto Fly dimatikan")
    elseif returningToSpawn then
        status.Text = "Sedang menuju SpawnLocation"
    else
        startFlying()
    end
end)
stopButton.Activated:Connect(function()
    returnToken += 1
    returningToSpawn = false
    stopFlying("Penerbangan dihentikan")
    local _, _, root = getCharacter()
    if root then
        for _, name in ipairs({"VXC_ReturnVelocity", "VXC_ReturnAttachment"}) do
            local object = root:FindFirstChild(name)
            if object then object:Destroy() end
        end
    end
end)

