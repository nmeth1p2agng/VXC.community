--==================================================
-- VXC ANTI DEAD V2.1
--==================================================

local AntiDeadEnabled = true
local AntiDeadCharacterConnection = nil
local AntiDeadHealthConnection = nil
local AntiDeadHeartbeatConnection = nil
local AntiDeadCharacter = nil

local function DisconnectAntiDeadCharacter()
    if AntiDeadHealthConnection then
        AntiDeadHealthConnection:Disconnect()
        AntiDeadHealthConnection = nil
    end
    if AntiDeadHeartbeatConnection then
        AntiDeadHeartbeatConnection:Disconnect()
        AntiDeadHeartbeatConnection = nil
    end
    AntiDeadCharacter = nil
end

local function ApplyAntiDead(character)
    if not AntiDeadEnabled or not character then return end
    DisconnectAntiDeadCharacter()

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or not humanoid.Parent or player.Character ~= character then
        return
    end
    AntiDeadCharacter = character

    pcall(function()
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end)

    local function CheckHealth()
        if not AntiDeadEnabled or player.Character ~= character or not humanoid.Parent then return end
        local health, maxHealth = humanoid.Health, humanoid.MaxHealth
        if health > 0 and maxHealth > 0 and health < maxHealth then
            pcall(function() humanoid.Health = maxHealth end)
        end
    end

    AntiDeadHealthConnection = humanoid.HealthChanged:Connect(CheckHealth)
    AntiDeadHeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not AntiDeadEnabled or player.Character ~= character or not humanoid.Parent then return end
        CheckHealth()
    end)
    CheckHealth()
    print("[VXC Anti Dead] Monitoring aktif")
end

DisconnectAntiDeadCharacter()
if player.Character then task.spawn(ApplyAntiDead, player.Character) end
if AntiDeadCharacterConnection then AntiDeadCharacterConnection:Disconnect() end
AntiDeadCharacterConnection = player.CharacterAdded:Connect(function(character)
    DisconnectAntiDeadCharacter()
    task.spawn(ApplyAntiDead, character)
end)
print("[VXC Anti Dead V2.1] Auto-start aktif")

